
{
  "uid": "modelforge-overview",
  "title": "ModelForge - API Monitoring",
  "tags": ["modelforge", "mlops", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Prediction Requests",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "modelforge_prediction_requests_total",
          "legendFormat": "Requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Successful Predictions",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "modelforge_predictions_succeeded_total",
          "legendFormat": "Successful",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Failed Predictions",
      "type": "stat",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 0},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "modelforge_predictions_failed_total",
          "legendFormat": "Failed",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Prediction Request Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "rate(modelforge_prediction_requests_total[5m])",
          "legendFormat": "Requests/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "reqps"},
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Average Prediction Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "modelforge_prediction_latency_average_seconds",
          "legendFormat": "Average",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "P95 Prediction Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {
          "expr": "modelforge_prediction_latency_p95_seconds",
          "legendFormat": "P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "s"},
        "overrides": []
      }
    }
  ],
  "refresh": "15s"
}
