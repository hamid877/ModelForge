GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# API Authentication Credentials (JSON-serialized list of client configurations)
# WARNING: The values below are development-only example credentials.
# These values MUST be replaced and must NEVER be used in production or shared environments.
MODELFORGE_API_KEYS='[{"client_id": "dev-predict-client", "token": "dev-predict-token-secret-replace-me", "roles": ["predict"]}, {"client_id": "dev-admin-client", "token": "dev-admin-token-secret-replace-me", "roles": ["admin"]}]'

